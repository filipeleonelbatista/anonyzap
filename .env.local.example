KV_URL=your_vercel_kv_connection_string
KV_REST_API_URL=your_vercel_kv_rest_url
KV_REST_API_TOKEN=your_vercel_kv_rest_token
KV_REST_API_READ_ONLY_TOKEN=your_vercel_kv_read_only_token
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Required for /api/cron/clean-blobs (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate_a_long_random_string

# Required for the GIF picker (/api/giphy) — create a free key at https://developers.giphy.com/
# The GIF button only appears when GIPHY_API_KEY AND IS_GIF_ENABLED are set
# (any non-empty value except "false"; free Beta key: 100 API calls/hour).
GIPHY_API_KEY=your_giphy_api_key
IS_GIF_ENABLED=true
